// To Install firewall //
# sudo apt install ufw

// To enable firewall //
# sudo ufw enable

// To check the status & numbering //
# sudo ufw status numbered

// To check the incoming and outgoing //
# sudo ufw status verbose

// To Add & delete Port and Protocol //
# sudo ufw allow 80
# sudo ufw allow ssh

// To Add specific subnet to server using specific protocol port TCP/22  //
$sudo ufw allow from 192.168.71.0/24 to 192.168.71.107 port 22 proto tcp
$sudo ufw allow from 192.168.69.0/24 to 192.168.71.107 port 22 proto tcp

Reference guide: https://linuxconfig.org/ubuntu-24-04-firewall-a-quick-guide
